# ==========================================
# North Voice Automation Credentials
# ==========================================

# 1. Google Gemini API Key (Get free from aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Supabase Credentials (Get from Supabase -> Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key_here

# 3. Facebook Graph API Credentials
# Leave empty for DRY-RUN mode (generates photocards and saves to output/ without posting)
FB_PAGE_ID=your_facebook_page_id
FB_PAGE_ACCESS_TOKEN=your_facebook_page_access_token

# 4. Optional Settings
DRY_RUN=false
MAX_POSTS_PER_RUN=1
DEBUG=true

# 5. Organic reach guardrails (defaults shown)
# Only North Bengal stories are posted. Set true to also allow national viral / international stories.
ALLOW_NATIONAL_VIRAL=false
# Posting window in Bangladesh time (24h clock, end exclusive)
POST_WINDOW_START_HOUR_BD=8
POST_WINDOW_END_HOUR_BD=23
MAX_POSTS_PER_DAY=6
MIN_MINUTES_BETWEEN_POSTS=90
# Gemini models tried in order; if all fail the story is skipped (never posted as copied text)
GEMINI_MODELS=gemini-3.8-flash,gemini-3.1-flash-lite
