# ==========================================
# North Voice Automation Credentials
# ==========================================

# 1. Google Gemini API Key (Get free from aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Supabase Credentials (Get from Supabase -> Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key_here

# 3. Facebook Graph API Credentials
# Leave empty for DRY-RUN mode (generates photocards and saves to output/ without posting)
FB_PAGE_ID=your_facebook_page_id
FB_PAGE_ACCESS_TOKEN=your_facebook_page_access_token

# 4. Optional Settings
DRY_RUN=false
MAX_POSTS_PER_RUN=1
DEBUG=true
